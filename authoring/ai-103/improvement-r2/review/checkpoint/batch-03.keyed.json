      ],
      "stem": "A catalog requires exact part-code matches and semantic symptom matches. Which design combines both retrieval signals before optional reranking?",
      "options": [
        {
          "id": "A",
          "text": "Vector retrieval alone, with a larger candidate count."
        },
        {
          "id": "B",
          "text": "Semantic reranking of keyword-only candidates."
        },
        {
          "id": "C",
          "text": "Keyword and vector retrieval with fused rankings."
        },
        {
          "id": "D",
          "text": "Keyword retrieval alone, with boosted identifier fields."
        }
      ],
      "correctAnswer": "C",
      "type": "single_choice",
      "difficulty": "medium",
      "explanation": {
        "whyCorrect": "Keyword evidence complements semantic vectors. Evaluate hybrid retrieval for the actual query set; ranking quality is distinct from generation and authentication.",
        "whyDistractorsWrong": {
          "A": "A larger vector candidate count does not add keyword retrieval.",
          "D": "Boosted keyword fields do not add vector retrieval.",
          "B": "Reranking keyword candidates does not combine keyword and vector retrieval."
        }
      },
